{
  "name": "@shlinkio/eslint-config-js-coding-standard",
  "description": "Coding standard used by shlink JavaScript projects",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./oxlint": {
      "import": "./dist/oxlint.js"
    },
    "./base": {
      "import": "./dist/base.js"
    },
    "./react": {
      "import": "./dist/react.js"
    },
    "./oxfmt": {
      "import": "./dist/oxfmt.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlinkio/js-coding-standard.git"
  },
  "keywords": [
    "oxlint",
    "oxfmt",
    "lint",
    "format",
    "typescript",
    "coding-standard"
  ],
  "author": "Alejandro Celaya <alejandro@alejandrocelaya.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shlinkio/js-coding-standard/issues"
  },
  "homepage": "https://github.com/shlinkio/js-coding-standard",
  "scripts": {
    "build": "mkdir -p dist && rm -rf dist/* && cp *.js dist"
  },
  "peerDependencies": {
    "oxfmt": ">=0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
