{
  "name": "@shlinkio/eslint-config-js-coding-standard",
  "description": "Coding standard used by shlink JavaScript projects",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./base": {
      "import": "./dist/base.js"
    },
    "./react": {
      "import": "./dist/react.js"
    },
    "./oxc/oxlint": {
      "import": "./dist/oxc/oxlint.js"
    },
    "./oxc/base": {
      "import": "./dist/oxc/base.js"
    },
    "./oxc/react": {
      "import": "./dist/oxc/react.js"
    },
    "./oxc/oxfmt": {
      "import": "./dist/oxc/oxfmt.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlinkio/js-coding-standard.git"
  },
  "keywords": [
    "eslint",
    "lint",
    "typescript",
    "coding-standard"
  ],
  "author": "Alejandro Celaya <alejandro@alejandrocelaya.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shlinkio/js-coding-standard/issues"
  },
  "homepage": "https://github.com/shlinkio/js-coding-standard",
  "scripts": {
    "build": "mkdir -p dist && rm -rf dist/* && cp *.js dist && cp -r oxc dist"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": ">=4.2.0",
    "eslint": "^10.0.0 || ^9.20.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-compiler": "*",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "oxfmt": ">=0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependenciesMeta": {
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-compiler": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-simple-import-sort": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
